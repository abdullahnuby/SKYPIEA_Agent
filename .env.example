# ============================================================
#  إعدادات الـ Agent — انسخ الملف ده إلى .env وعدّل القيم
# ============================================================

AGENT_NAME=Zaki

# ---------- تيليجرام ----------
# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IDs المسموح لها بالكلام مع البوت (افصل بينهم بفاصلة)
# خد الـ ID من @userinfobot — ومتسيبهاش فاضية أبدًا
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------- الموديل ----------
# أي خدمة بتتكلم OpenAI-compatible API
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1      (المفتاح أي قيمة، مثل ollama)
#   LM Studio:   http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.3

# ---------- الصلاحيات ----------
# ask  = أي أمر خطير يستنى موافقتك من تيليجرام  (الافتراضي والآمن)
# auto = ينفّذ من غير سؤال (خطير — استخدمه بس لو فاهم النتيجة)
APPROVAL_MODE=ask

# auto  = لو فيه موديل استخدمه، غير كده قواعد
# llm   = موديل لغوي فقط
# rules = قواعد + تعلم (بدون موديل — أسرع ومجاني)
AGENT_MODE=auto
APPROVAL_TIMEOUT=300
MAX_STEPS=25
SHELL_TIMEOUT=120

# ---------- المسارات ----------
# كل أوامر الملفات محصورة جوه المجلد ده
WORKSPACE=./workspace
DB_PATH=./data/agent.db
LOG_PATH=./data/audit.log
# موديل النوايا المتدرّب محليًا (اختياري — بيتولّد بـ /train)
INTENT_MODEL=./data/intent_model.npz

# ---------- المتصفح (اختياري) ----------
BROWSER_ENABLED=false
BROWSER_HEADLESS=true

# ---------- الإيميل (اختياري) ----------
# Gmail: لازم App Password مش كلمة السر العادية
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=
